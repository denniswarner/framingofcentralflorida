---
interface Props {
  name: "facebook" | "instagram" | "menu" | "close";
  class?: string;
  width?: number;
  height?: number;
}

const { name, class: className, width = 24, height = 24 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={width}
  height={height}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === "facebook" && (
      <path d="M17 2H14C12.6739 2 11.4021 2.52678 10.4645 3.46447C9.52678 4.40215 9 5.67392 9 7V10H6V14H9V22H13V14H16L17 10H13V7C13 6.73478 13.1054 6.48043 13.2929 6.29289C13.4804 6.10536 13.7348 6 14 6H17V2Z" />
    )
  }
  {
    name === "instagram" && (
      <>
        <path d="M12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16Z" />
        <path d="M3 16V8C3 5.23858 5.23858 3 8 3H16C18.7614 3 21 5.23858 21 8V16C21 18.7614 18.7614 21 16 21H8C5.23858 21 3 18.7614 3 16Z" />
        <path d="M17.5 6.51L17.51 6.49889" />
      </>
    )
  }
  {
    name === "menu" && (
      <>
        <path d="M3 5H21" />
        <path d="M3 12H21" />
        <path d="M3 19H21" />
      </>
    )
  }
  {
    name === "close" && (
      <>
        <path d="M6 6L18 18" />
        <path d="M18 6L6 18" />
      </>
    )
  }
</svg>
