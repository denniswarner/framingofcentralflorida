---
import { navLinks } from "@/data/nav";
import { socialLinks } from "@/data/social-links";
import Icon from "@/components/icons.astro";
import Ornament from "@/components/ornaments.astro";

const year = new Date().getFullYear();
const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=Framing+of+Central+Florida%2C+1820+N+Orange+Ave%2C+Orlando%2C+FL+32804";
---

<footer class="border-t border-accent bg-foreground text-background">
  <div class="container mx-auto px-4 py-14">
    <div class="flex flex-col items-center gap-3 text-center">
      <Ornament name="chevron" class="h-3 w-32 text-accent" />
      <span class="font-heading text-sm font-semibold tracking-[0.25em]">
        FRAMING OF CENTRAL FLORIDA
      </span>
    </div>

    <div
      class="mx-auto mt-12 grid max-w-4xl gap-10 text-center sm:grid-cols-3 sm:text-left"
    >
      <div class="space-y-4">
        <h2 class="text-sm uppercase tracking-[0.4em] text-accent">Visit</h2>
        <address class="text-sm not-italic leading-relaxed text-background/80">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            1820 N. Orange Ave
            <br />
            Orlando, FL 32804
          </a>
          <br />
          <a href="tel:+14078948644" class="transition-colors hover:text-accent">
            (407) 894-8644
          </a>
        </address>
      </div>

      <div class="space-y-4">
        <h2 class="text-sm uppercase tracking-[0.4em] text-accent">
          Quick Links
        </h2>
        <nav aria-label="Footer" class="flex flex-col gap-2">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm text-background/80 transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>

      <div class="space-y-4">
        <h2 class="text-sm uppercase tracking-[0.4em] text-accent">Hours</h2>
        <p class="text-sm leading-relaxed text-background/80">
          Monday – Friday: 10 AM – 5 PM
          <br />
          Saturday: 10 AM – 3 PM
          <br />
          Sunday: Closed
        </p>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-center gap-4 border-t border-accent/40 pt-6 sm:flex-row sm:justify-between"
    >
      <p class="text-sm uppercase tracking-[0.3em] text-background/60">
        &copy; {year} Framing of Central Florida
        <span class="ml-2 text-background/60">v0.3</span>
      </p>
      <ul class="flex items-center gap-4">
        {
          socialLinks.map(({ href, label, icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
                class="text-background/60 transition-colors hover:text-accent"
              >
                <Icon name={icon} width={20} height={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
