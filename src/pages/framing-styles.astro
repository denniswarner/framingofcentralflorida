---
import Base from "@/layouts/Base.astro";
import Ornament from "@/components/ornaments.astro";

const framingStyles = [
  {
    title: "Traditional Wood",
    description:
      "Classic hardwood frames in a variety of stains and profiles, perfect for fine art and portraits.",
  },
  {
    title: "Ornate & Gold",
    description:
      "Elegant gilded and decorative frames that add a timeless, museum-quality look.",
  },
  {
    title: "Modern & Minimalist",
    description:
      "Clean lines and slim profiles for contemporary art and photography.",
  },
  {
    title: "Shadow Box",
    description:
      "Deep frames for dimensional objects like jerseys, memorabilia, and keepsakes.",
  },
];
---

<Base
  title="Styles"
  description="Explore our custom framing styles — from traditional wood and ornate gold to modern minimalist and shadow box options."
>
  <main class="container mx-auto px-4 py-16 lg:py-24">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="mx-auto max-w-2xl space-y-6 text-center">
        <p class="text-sm uppercase tracking-[0.5em] text-accent-deep">
          Our Craft
        </p>
        <h1
          class="font-heading text-4xl font-semibold tracking-[0.06em] sm:text-5xl"
        >
          STYLES
        </h1>
        <div class="flex justify-center">
          <Ornament name="chevron" class="h-3 w-32 text-accent" />
        </div>
        <p class="text-lg leading-relaxed text-muted-foreground">
          Whatever your vision, we have a framing style to match. Browse our
          options below or visit us for a personalized consultation.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          framingStyles.map((style) => (
            <div class="border border-accent p-2">
              <div class="flex h-full flex-col border border-accent p-6 text-center">
                <div class="mb-5 h-32 bg-muted" />
                <h2 class="font-heading text-lg font-medium tracking-[0.1em]">
                  {style.title.toUpperCase()}
                </h2>
                <p class="mt-3 flex-1 text-base leading-relaxed text-muted-foreground">
                  {style.description}
                </p>
                <p class="mt-4 text-sm tracking-[0.3em] text-muted-foreground uppercase">
                  [Sample images to be added]
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Base>
