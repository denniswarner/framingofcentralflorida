---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/icons.astro";
import Ornament from "@/components/ornaments.astro";
import { socialLinks } from "@/data/social-links";

const mapsUrl =
  "https://www.google.com/maps/search/?api=1&query=Framing+of+Central+Florida%2C+1820+N+Orange+Ave%2C+Orlando%2C+FL+32804";

const labelClass =
  "flex items-center gap-2 text-sm leading-none font-medium select-none";
const fieldClass =
  "w-full min-w-0 rounded-lg border border-input bg-transparent px-2.5 text-base transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:bg-input/50 disabled:opacity-50 md:text-sm";
---

<Base
  title="Contact Us"
  description="Get in touch with Framing of Central Florida. Visit our shop, call us, or send a message for a free consultation."
>
  <main class="container mx-auto px-4 py-16 lg:py-24">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="mx-auto max-w-2xl space-y-6 text-center">
        <p class="text-sm uppercase tracking-[0.5em] text-accent-deep">
          Get In Touch
        </p>
        <h1
          class="font-heading text-4xl font-semibold tracking-[0.06em] sm:text-5xl"
        >
          CONTACT US
        </h1>
        <div class="flex justify-center">
          <Ornament name="chevron" class="h-3 w-32 text-accent" />
        </div>
        <p class="text-lg leading-relaxed text-muted-foreground">
          Have a question or ready to start a project? Reach out and we'll get
          back to you promptly.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <div class="border border-accent p-2">
          <div class="h-full border border-accent p-8">
            <h2 class="font-heading text-xl font-medium tracking-[0.1em]">
              SEND US A MESSAGE
            </h2>
            <p class="mt-2 text-base text-muted-foreground">
              Fill out the form below and we'll respond within one business
              day.
            </p>
            <p
              class="mt-4 border-l border-accent pl-4 text-base leading-relaxed text-muted-foreground italic"
            >
              Because every frame we build is designed and fitted by hand, we
              don't take orders online. Every project starts with an in-person
              consultation at our shop, and we're happy to answer questions
              here before you visit.
            </p>
            <form class="mt-8 space-y-4">
              <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                  <label for="firstName" class={labelClass}>First Name</label>
                  <input
                    id="firstName"
                    placeholder="John"
                    class:list={[fieldClass, "h-8 py-1"]}
                  />
                </div>
                <div class="space-y-2">
                  <label for="lastName" class={labelClass}>Last Name</label>
                  <input
                    id="lastName"
                    placeholder="Doe"
                    class:list={[fieldClass, "h-8 py-1"]}
                  />
                </div>
              </div>
              <div class="space-y-2">
                <label for="email" class={labelClass}>Email</label>
                <input
                  id="email"
                  type="email"
                  placeholder="john@example.com"
                  class:list={[fieldClass, "h-8 py-1"]}
                />
              </div>
              <div class="space-y-2">
                <label for="phone" class={labelClass}>Phone</label>
                <input
                  id="phone"
                  type="tel"
                  placeholder="(407) 555-1234"
                  class:list={[fieldClass, "h-8 py-1"]}
                />
              </div>
              <div class="space-y-2">
                <label for="message" class={labelClass}>Message</label>
                <textarea
                  id="message"
                  rows="5"
                  placeholder="Tell us about your framing project..."
                  class:list={[
                    fieldClass,
                    "flex field-sizing-content min-h-16 py-2",
                  ]}></textarea>
              </div>
              <button
                type="button"
                class="w-full border border-accent bg-primary px-9 py-4 font-heading text-sm font-semibold tracking-[0.3em] text-primary-foreground uppercase transition-opacity hover:opacity-90"
              >
                Send Message
              </button>
            </form>
          </div>
        </div>

        <div class="space-y-6">
          <div class="border border-accent p-2">
            <div class="border border-accent p-8">
              <h2 class="font-heading text-xl font-medium tracking-[0.1em]">
                VISIT OUR SHOP
              </h2>
              <div class="mt-6 space-y-4">
                <address
                  class="text-base leading-relaxed text-muted-foreground not-italic"
                >
                  <a
                    href={mapsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="transition-colors hover:text-foreground"
                  >
                    1820 N. Orange Ave
                    <br />
                    Orlando, FL 32804
                  </a>
                </address>
                <p class="text-base text-muted-foreground">
                  <strong class="font-medium text-foreground">Phone:</strong>
                  {" "}
                  <a
                    href="tel:+14078948644"
                    class="transition-colors hover:text-foreground"
                  >
                    (407) 894-8644
                  </a>
                </p>
                <p class="text-base text-muted-foreground">
                  <strong class="font-medium text-foreground">Email:</strong>
                  {" "}
                  <a
                    href="mailto:framingofcentralflorida@gmail.com"
                    class="transition-colors hover:text-foreground"
                  >
                    framingofcentralflorida@gmail.com
                  </a>
                </p>
                <p class="text-base text-muted-foreground">
                  <strong class="font-medium text-foreground">Hours:</strong>
                  <br />
                  Mon–Fri: 10 AM – 5 PM
                  <br />
                  Saturday: 10 AM – 3 PM
                  <br />
                  Sunday: Closed
                </p>
                <div class="text-base text-muted-foreground">
                  <strong class="font-medium text-foreground">Follow:</strong>
                  <ul class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-2">
                    {
                      socialLinks.map(({ href, label, icon }) => (
                        <li>
                          <a
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-2 transition-colors hover:text-foreground"
                          >
                            <Icon name={icon} width={18} height={18} />
                            {label}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
                <a
                  href={mapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-3 border border-accent bg-primary px-9 py-4 font-heading text-sm font-semibold tracking-[0.3em] text-primary-foreground uppercase transition-opacity hover:opacity-90"
                >
                  Get Directions
                </a>
              </div>
            </div>
          </div>

          <div
            class="aspect-video overflow-hidden border border-accent bg-muted"
          >
            <div
              class="flex h-full items-center justify-center text-sm tracking-[0.3em] text-muted-foreground uppercase"
            >
              [Google Maps embed to be added]
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Base>
