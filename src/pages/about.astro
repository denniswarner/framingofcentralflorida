---
import Base from "@/layouts/Base.astro";
import Ornament from "@/components/ornaments.astro";
---

<Base
  title="About"
  description="Learn about Framing of Central Florida — our story, our team, and our commitment to quality custom framing."
>
  <main class="container mx-auto px-4 py-16 lg:py-24">
    <div class="mx-auto max-w-3xl space-y-10 text-center">
      <div class="space-y-6">
        <p class="text-sm uppercase tracking-[0.5em] text-accent-deep">
          Our Story
        </p>
        <h1
          class="font-heading text-4xl font-semibold tracking-[0.06em] sm:text-5xl"
        >
          ABOUT
        </h1>
        <div class="flex justify-center">
          <Ornament name="chevron" class="h-3 w-32 text-accent" />
        </div>
      </div>
      <p class="text-lg leading-relaxed">
        With decades of experience in custom framing, Framing of Central
        Florida has been proudly serving the Orlando area. Our skilled team
        combines traditional craftsmanship with modern techniques to preserve
        and display what matters most to you.
      </p>
      <p class="text-lg leading-relaxed">
        Custom framing is hands-on work. Choosing the right moulding, mat, and
        glass means seeing your piece in person, holding samples against it,
        and talking through where it will hang. Because that specialized,
        personal approach is at the heart of what we do, we don't offer online
        ordering. Every project begins with a free consultation at our shop on
        North Orange Avenue: bring your piece in, and we'll design its frame
        together.
      </p>
      <div class="border border-accent p-3">
        <div
          class="border border-accent p-10 text-sm tracking-[0.3em] text-muted-foreground uppercase"
        >
          [Team photo and detailed story content to be added]
        </div>
      </div>
    </div>
  </main>
</Base>
