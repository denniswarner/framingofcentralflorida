---
import Base from "@/layouts/Base.astro";
import Ornament from "@/components/ornaments.astro";

const services = [
  {
    title: "Glass Replacement",
    description:
      "Broken or scratched glass replaced, or upgraded to non-glare, UV-protective glass, or acrylic.",
  },
  {
    title: "Mat Replacement",
    description:
      "A faded, stained, or ill-fitting mat swapped so the piece looks right and stays protected.",
  },
  {
    title: "Frame Repair",
    description:
      "Loose corners tightened, broken joints mended, and a worn frame put back in shape.",
  },
  {
    title: "Canvas Stretching",
    description:
      "Professional stretching and framing for canvas prints and original paintings.",
  },
  {
    title: "Memorabilia",
    description: "Jerseys, medals, flags, and keepsakes mounted in a shadow box.",
  },
  {
    title: "Diplomas & Documents",
    description: "Diplomas, certificates, and documents framed to last.",
  },
  {
    title: "Commercial Framing",
    description: "Matching frames for offices, restaurants, hotels, and clinics.",
  },
  {
    title: "Installation",
    description: "Hanging and hardware for finished pieces at home or on site.",
  },
];
---

<Base
  title="Services"
  description="Glass replacement, frame repair, canvas stretching, memorabilia, diplomas, and commercial framing in Orlando."
>
  <main class="container mx-auto px-4 py-16 lg:py-24">
    <div class="mx-auto max-w-5xl space-y-12">
      <div class="mx-auto max-w-2xl space-y-6 text-center">
        <p class="text-sm uppercase tracking-[0.5em] text-accent-deep">
          What We Do
        </p>
        <h1
          class="font-heading text-4xl font-semibold tracking-[0.06em] sm:text-5xl"
        >
          SERVICES
        </h1>
        <div class="flex justify-center">
          <Ornament name="chevron" class="h-3 w-32 text-accent" />
        </div>
        <p class="text-lg leading-relaxed text-muted-foreground">
          Bring in a piece to frame, or a frame that needs work. We replace
          glass and mats, repair frames, stretch canvases, and frame diplomas,
          memorabilia, and sets for homes and businesses.
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <div class="border border-accent p-2">
              <div class="flex h-full flex-col border border-accent p-6 text-center">
                <div class="mb-5 h-32 bg-muted" />
                <h2 class="font-heading text-lg font-medium tracking-[0.1em]">
                  {service.title.toUpperCase()}
                </h2>
                <p class="mt-3 flex-1 text-base leading-relaxed text-muted-foreground">
                  {service.description}
                </p>
                <p class="mt-4 text-sm tracking-[0.3em] text-muted-foreground uppercase">
                  [Sample images to be added]
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
</Base>
